#!/usr/bin/env zsh
set -euo pipefail

usage="Usage: secret [-l|--list] [-d|--delete <name>] [<name>]
  Print the secret stored in the login keychain under <name>.
  If stdin is not a terminal, store it as that secret instead.
  Storing an existing name fails.
  -l, --list                 List secret names.
  -d, --delete <name>        Delete a secret.

  printf '%s' \"value\" | secret <name>"

list_names() {
    local line class acct svce
    local -a names
    class= acct= svce=
    while IFS= read -r line; do
        if [[ $line == keychain:* ]]; then
            [[ $class == genp && $svce == "$service" && -n $acct ]] && names+=("$acct")
            class= acct= svce=
            continue
        fi
        case $line in
            'class: '*)
                class=${line#class: }
                class=${${class#\"}%\"}
                ;;
            *'"acct"<blob>='*)
                acct=${line#*'"acct"<blob>='}
                if [[ $acct == \"*\" ]]; then
                    acct=${${acct#\"}%\"}
                else
                    acct=
                fi
                ;;
            *'"svce"<blob>='*)
                svce=${line#*'"svce"<blob>='}
                if [[ $svce == \"*\" ]]; then
                    svce=${${svce#\"}%\"}
                else
                    svce=
                fi
                ;;
        esac
    done <<< "$(security dump-keychain)"
    [[ $class == genp && $svce == "$service" && -n $acct ]] && names+=("$acct")
    (( ${#names} )) && print -rl -- "${(@o)names}"
}

service=my-zcomet

list=0
case ${1:-} in
    -h|--help)
        print -r -- "$usage"
        exit 0
        ;;
    -l|--list)
        list=1
        shift
        ;;
    -d|--delete)
        shift
        [[ $# -eq 1 ]] || { print -ru2 -- "$usage"; exit 1 }
        name=$1
        if ! err=$(security delete-generic-password -s "$service" -a "$name" 2>&1); then
            if [[ $err == *could\ not\ be\ found* ]]; then
                print -ru2 -- "secret: no such secret: $name"
            else
                print -ru2 -- "$err"
            fi
            exit 1
        fi
        print -r -- "Deleted '$name'"
        exit 0
        ;;
    '')
        print -ru2 -- "$usage"
        exit 1
        ;;
esac

if (( list )); then
    [[ $# -eq 0 ]] || { print -ru2 -- "$usage"; exit 1 }
    list_names
    exit 0
fi

[[ $# -eq 1 ]] || { print -ru2 -- "$usage"; exit 1 }

name=$1

if [[ -t 0 ]]; then
    security find-generic-password -s "$service" -a "$name" -w
else
    value=$(cat)
    if ! err=$(security add-generic-password -s "$service" -a "$name" -l "$name" -w "$value" 2>&1); then
        if [[ $err == *already\ exists* ]]; then
            print -ru2 -- "secret: '$name' already exists"
        else
            print -ru2 -- "$err"
        fi
        exit 1
    fi
fi
