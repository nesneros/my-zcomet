#!/bin/zsh -e

CLIP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/clip"

mkdir -p "$CLIP_DIR"

usage="Usage: clip [-l|-d <name>|-h] [<name>]

  Copy between the clipboard and stdin/stdout, and store named snippets.

  With no name and nothing piped on stdin, prints the clipboard.
  With no name and stdin piped, copies stdin to the clipboard.

  With a name and nothing piped, copies the saved snippet to the
  clipboard and prints it. With a name and stdin piped, saves stdin
  as that snippet and copies it to the clipboard.

  -l, --list          list all saved snippets
  -d, --delete <name> delete a named snippet
  -h, --help          show this help"

no_args() {
  if [[ -t 0 ]]; then
    pbpaste
  else
    pbcopy
  fi
}
[[ $# -eq 0 ]] && no_args && exit 0

case "$1" in
-h | --help)
  print -r -- "$usage"
  ;;
-l | --list)
  ls -1 "$CLIP_DIR"
  ;;
-d | --delete)
  [[ -z "$2" ]] && print -r -- "$usage" && exit 1
  rm -f "$CLIP_DIR/$2" && echo "Deleted '$2'"
  ;;
-*)
  print -r -- "$usage" && exit 1
  ;;
*)
  if [[ -t 0 ]]; then
    [[ ! -f "$CLIP_DIR/$1" ]] && echo "Invalid name: $1" && exit 1
    cat "$CLIP_DIR/$1" | pbcopy
    pbpaste
  else
    pbcopy
    pbpaste >"$CLIP_DIR/$1"
  fi
  ;;
esac
